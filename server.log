Conteúdo: [\n  {\n    \"name\": \"Princess Budu\",\n    \"bio\": \"A mystical princess who dreams of fairies and beastial spirits. She is deeply in love with Prince Kamar and embodies the enchanting atmosphere of the 1001 Nights.\",\n    \"characteristics\": {\n      \"gender\": \"Female\",\n      \"eyeColor\": \"Unknown\",\n      \"hairColor\": \"Unknown\",\n      \"hairLength\": \"Unknown\",\n      \"apparentAge\": \"Young Adult\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\n      \"Fairies\",\n      \"Beastmasters\",\n      \"Fantasy\",\n      \"Romantic\",\n      \"Magical Girl\",\n      \"Princess\",\n      \"Dreamers\"\n    ]\n  },\n  {\n    \"name\": \"Prince Kamar\",\n    \"bio\": \"The devoted lover of Princess Budu, sharing her mystical world and passion. A noble prince who stands by her side in their dreamlike journey.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Unknown\",\n      \"hairColor\": \"Unknown\",\n      \"hairLength\": \"Unknown\",\n      \"apparentAge\": \"Young Adult\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\n      \"Nobility\",\n      \"Romantic\",\n      \"Prince\",\n      \"Fantasy\",\n      \"Loyal\",\n      \"Dreamers\",\n      \"Protectors\"\n    ]\n  }\n]
