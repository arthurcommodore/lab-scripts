Conteúdo: [\n  {\n    \"name\": \"Kosaku Hatanaka\",\n    \"bio\": \"Kosaku Hatanaka is a talented young boxer from Mukouda Gym renowned for his powerful punches. Despite his natural skill, his voracious appetite forces him to change weight classes frequently, moving from flyweight to featherweight and often accepting fights against heavier opponents, much to his and his trainer's concern.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Brown\",\n      \"hairColor\": \"Black\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Late Teens\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Boxers\", \"Big Eaters\", \"Martial Artists\", \"High School Students\", \"Strong\", \"Determined\", \"Gluttony\", \"Athletes\"]\n  },\n  {\n    \"name\": \"Sister Angela\",\n    \"bio\": \"A novice nun committed to helping Kosaku improve his discipline and control his eating habits. Sister Angela is supportive and persevering, though she finds herself struggling with her own feelings as she grows closer to Kosaku.\",\n    \"characteristics\": {\n      \"gender\": \"Female\",\n      \"eyeColor\": \"Blue\",\n      \"hairColor\": \"Blonde\",\n      \"hairLength\": \"Long\",\n      \"apparentAge\": \"Early 20s\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Nuns\", \"Religious\", \"Supportive\", \"Determined\", \"Caring\", \"Single Parent\", \"Strong-Willed\", \"Kind\"]\n  },\n  {\n    \"name\": \"Jiro Amakusa\",\n    \"bio\": \"Jiro Amakusa is an accomplished Olympic gold medalist boxer who has transitioned to the professional ranks, bringing experience and exceptional skill to the ring.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Dark Brown\",\n      \"hairColor\": \"Black\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Mid 20s\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Boxers\", \"Olympic Gold Medalists\", \"Martial Artists\", \"Professional Athletes\", \"Determined\", \"Strong\", \"Competitors\"]\n  },\n  {\n    \"name\": \"Ishida\",\n    \"bio\": \"Ishida is the main coach and trainer at Mukouda Gym, responsible for guiding and training boxers like Kosaku Hatanaka to reach their full potential.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Black\",\n      \"hairColor\": \"Grey\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Middle-aged\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Coaches\", \"Trainers\", \"Mentors\", \"Martial Artists\", \"Teacher\", \"Supportive\", \"Disciplined\"]\n  },\n  {\n    \"name\": \"Tabuchi\",\n    \"bio\": \"Tabuchi is one of Kosaku's juniors at the Mukouda Gym, a promising boxer training under the same gym's guidance.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Brown\",\n      \"hairColor\": \"Black\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Late Teens\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Boxers\", \"Students\", \"Martial Artists\", \"Young\", \"Determined\", \"Athletes\"]\n  },\n  {\n    \"name\": \"Coach Mukoda\",\n    \"bio\": \"Coach Mukoda is a dedicated boxing coach at Mukouda Gym who plays a key role in developing the skills and discipline of his fighters.\",\n    \"characteristics\": {\n      \"gender\": \"Male\",\n      \"eyeColor\": \"Black\",\n      \"hairColor\": \"Grey\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Middle-aged\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Coaches\", \"Mentors\", \"Martial Artists\", \"Trainers\", \"Disciplined\", \"Supportive\"]\n  }\n]
