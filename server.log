le\",\n      \"eyeColor\": \"Dark Brown\",\n      \"hairColor\": \"Black\",\n      \"hairLength\": \"Short\",\n      \"apparentAge\": \"Adult\",\n      \"animalEars\": \"No\"\n    },\n    \"tags\": [\"Merchants\", \"Shrewd\", \"Loyal\", \"Information Brokers\"]\n  }\n]
